{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-task-pointer/state-v3.schema.json",
  "title": "Codex Task Pointer state v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "generation",
    "revision",
    "status",
    "task_id",
    "pointer_text",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^g-[0-9a-f]{32}$"
    },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["CLEAN", "DIRTY", "CLEARED"] },
    "task_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "pointer_text": { "type": ["string", "null"], "minLength": 1 },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "CLEARED" } } },
      "then": {
        "properties": {
          "task_id": { "type": "null" },
          "pointer_text": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["CLEAN", "DIRTY"] } } },
      "then": {
        "properties": {
          "task_id": { "type": "string" },
          "pointer_text": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
